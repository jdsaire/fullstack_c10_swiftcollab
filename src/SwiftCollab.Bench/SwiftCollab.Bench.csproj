<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SwiftCollab.Baseline\SwiftCollab.Baseline.csproj" />
    <ProjectReference Include="..\SwiftCollab.Core\SwiftCollab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Every method runs fully optimized from its first call, so a case timed first is not measured
         on the quick first-pass JIT code (seen in the first sweep: identical code paths 3x apart). -->
    <TieredCompilation>false</TieredCompilation>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
